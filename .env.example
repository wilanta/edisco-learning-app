# Local development only. Copy to .env at the repository root.
HOST=127.0.0.1
PORT=3001
REDIS_URL=redis://127.0.0.1:6379

# Local PostgreSQL. If 5432 is occupied, change both ports below.
POSTGRES_PORT=5432
POSTGRES_USER=edisco
POSTGRES_PASSWORD=edisco_local_only
POSTGRES_DB=edisco
DATABASE_URL=postgresql://edisco:edisco_local_only@127.0.0.1:5432/edisco
