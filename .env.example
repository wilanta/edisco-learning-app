# Local development only. Copy to .env at the repository root.
HOST=127.0.0.1
PORT=3001
REDIS_URL=redis://127.0.0.1:6379
# Opt in only for Phase 4A pipeline verification; DONE does not create a lesson.
GENERATION_PLACEHOLDER_ENABLED=false
# Real generation + semantic reuse (quota still deferred); exclusive with placeholder.
GENERATION_LLM_ENABLED=false
# Worker only. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini-2024-07-18
# Required in LLM mode: maximum cosine distance in [0,2], inclusive.
# No production default: choose through evaluation. Change env and restart workers.
SIMILARITY_MAX_DISTANCE=
# Set a private signing secret before starting the authenticated API.
JWT_SECRET=

# Local PostgreSQL. If 5432 is occupied, change both ports below.
POSTGRES_PORT=5432
POSTGRES_USER=edisco
POSTGRES_PASSWORD=edisco_local_only
POSTGRES_DB=edisco
DATABASE_URL=postgresql://edisco:edisco_local_only@127.0.0.1:5432/edisco
