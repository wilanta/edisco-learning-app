{
  "name": "@edisco/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "node ../../node_modules/drizzle-kit/bin.cjs generate --config=drizzle.config.ts",
    "db:migrate": "node --env-file-if-exists=../../.env ../../node_modules/drizzle-kit/bin.cjs migrate --config=drizzle.config.ts"
  },
  "dependencies": {
    "@edisco/database": "*",
    "@edisco/shared-types": "*",
    "@fastify/jwt": "^10.2.2",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "fastify": "5.12.5",
    "zod": "^4.6.5"
  }
}
