{
  "name": "@edisco/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --import ../../node_modules/tsx/dist/loader.mjs src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@edisco/database": "*",
    "@edisco/shared-types": "*",
    "bullmq": "6.3.8",
    "drizzle-orm": "0.45.2",
    "ioredis": "^5.8.2",
    "zod": "4.6.5"
  }
}
